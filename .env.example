# Sanity (blog). Project ID from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Admin dashboard login (server-only). Set these in your host's environment settings too.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the admin session cookie. Must be at least 32 characters: openssl rand -hex 32
SECRET_KEY=

# Firebase service-account key (server-only) used by /api/links to add/delete dashboard links.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON on one line, or base64 it: base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// The site only reads the "link" collection from the browser. Adding and deleting
// happens in pages/api/links.js with the Admin SDK, which is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /link/{linkId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
